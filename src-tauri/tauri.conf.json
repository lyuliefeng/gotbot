{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "道听徒说",
  "version": "3.0.0",
  "identifier": "com.samuel.samimage.v3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:3030",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "道听徒说",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
