page {
  background: #f4f7fa;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', sans-serif;
}

view,
text,
button,
input,
textarea,
picker,
image {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 144rpx;
}

.section {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.045);
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  line-height: 1.22;
}

.subtitle,
.muted {
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}

.field {
  margin-top: 20rpx;
}

.label {
  display: block;
  font-size: 25rpx;
  color: #334155;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  min-height: 84rpx;
  border: 1rpx solid #dbe5ee;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  background: #f8fbfd;
  font-size: 28rpx;
  color: #0f172a;
}

.textarea {
  height: 180rpx;
}

.row,
.chips,
.actions,
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip,
.button-soft,
.button-primary,
.button-danger {
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #d6e0ea;
  background: #ffffff;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.2;
  text-align: center;
}

.chip::after,
.button-soft::after,
.button-primary::after,
.button-danger::after {
  border: 0;
}

.chip.active,
.button-primary {
  border-color: #1d4ed8;
  background: #1d4ed8;
  color: #ffffff;
}

.button-danger {
  border-color: #fecaca;
  background: #fff7f7;
  color: #b91c1c;
}

.card {
  width: calc(50% - 7rpx);
  border: 1rpx solid #dfe7ef;
  border-radius: 14rpx;
  padding: 18rpx;
  background: #fbfdff;
}

.preview {
  width: 100%;
  height: 300rpx;
  border-radius: 14rpx;
  background: #e2e8f0;
}

.danger-text {
  color: #b91c1c;
  font-size: 26rpx;
  margin-top: 14rpx;
}

.success-text {
  color: #047857;
  font-size: 26rpx;
  margin-top: 14rpx;
}
