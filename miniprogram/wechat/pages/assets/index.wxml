<view class="page">
  <view class="assets-hero">
    <view class="eyebrow">Asset Library</view>
    <view class="title">资产库</view>
    <view class="subtitle">生成的图片和视频会自动进入对应仓库。</view>
  </view>

  <view class="section library-toolbar">
    <view class="library-tabs">
      <button class="library-tab {{imageTabClass}}" data-library="image" bindtap="switchLibrary">
        <view class="tab-label">图片</view>
        <view class="tab-count">{{imageCountText}}</view>
      </button>
      <button class="library-tab {{videoTabClass}}" data-library="video" bindtap="switchLibrary">
        <view class="tab-label">视频</view>
        <view class="tab-count">{{videoCountText}}</view>
      </button>
      <button class="library-tab {{favoriteTabClass}}" data-library="favorite" bindtap="switchLibrary">
        <view class="tab-label">收藏</view>
        <view class="tab-count">{{favoriteCountText}}</view>
      </button>
    </view>
  </view>

  <view class="library-summary">
    <view>
      <view class="summary-title">{{libraryTitle}}</view>
      <view class="summary-text">{{librarySummary}}</view>
    </view>
    <button class="summary-action {{favoriteFilterClass}}" bindtap="toggleFilter">收藏</button>
  </view>

  <view wx:if="{{hasVisibleAssets}}" class="asset-grid">
    <view wx:for="{{visibleAssets}}" wx:key="id" class="asset-card">
      <image class="asset-preview" src="{{item.assetUrl}}" mode="aspectFill" data-url="{{item.assetUrl}}" bindtap="previewAsset" />
      <view class="asset-body">
        <view class="asset-title">{{item.title}}</view>
        <view class="muted">{{item.taskModeLabel}} · {{item.format}} · {{item.width}} x {{item.height}}</view>
        <view class="asset-prompt">{{item.taskPrompt}}</view>
        <view class="asset-actions">
          <button class="button-soft" data-task-id="{{item.taskId}}" data-asset-id="{{item.id}}" bindtap="toggleFavorite">{{item.favoriteText}}</button>
          <button class="button-danger compact-danger" data-id="{{item.taskId}}" bindtap="deleteTask">删除任务</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="section empty-state">
    <view class="muted">{{emptyText}}</view>
  </view>
</view>
