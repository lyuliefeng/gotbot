.assets-hero {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.045);
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.library-toolbar {
  padding: 12rpx;
}

.library-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  padding: 5rpx;
  border: 1rpx solid #dbe5ee;
  border-radius: 12rpx;
  background: #f8fbfd;
}

.library-tab {
  height: 72rpx;
  min-height: 72rpx;
  padding: 8rpx 4rpx;
  border: 0;
  border-radius: 9rpx;
  background: transparent;
  color: #475569;
  line-height: 1.1;
  overflow: hidden;
}

.library-tab.active {
  background: #1d4ed8;
  color: #ffffff;
}

.library-tab::after {
  border: 0;
}

.tab-label {
  color: inherit;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
}

.tab-count {
  margin-top: 5rpx;
  color: inherit;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.library-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
}

.summary-title {
  color: #0f172a;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.25;
}

.summary-text {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.3;
}

.summary-action {
  width: 128rpx;
  min-width: 128rpx;
  height: 64rpx;
  padding: 0;
  border: 1rpx solid #badfd7;
  border-radius: 12rpx;
  background: #effaf7;
  color: #0f766e;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.summary-action.active {
  border-color: #0f766e;
  background: #0f766e;
  color: #ffffff;
}

.summary-action::after {
  border: 0;
}

.asset-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 18rpx;
}

.asset-card {
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  overflow: hidden;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
}

.asset-preview {
  width: 100%;
  height: 100%;
  min-height: 232rpx;
  background: #eef3f7;
}

.asset-body {
  padding: 16rpx;
}

.asset-title {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-word;
}

.asset-prompt {
  height: 68rpx;
  margin-top: 10rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.45;
  overflow: hidden;
}

.asset-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.compact-danger {
  margin-top: 0;
}

.empty-state {
  text-align: center;
}
