.settings-hero {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.045);
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.config-section {
  padding-top: 24rpx;
}

.platform-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #cfe8e3;
  border-radius: 14rpx;
  background: #f3fbf8;
}

.platform-label {
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.35;
}

.platform-value {
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.platform-badge {
  flex: none;
  min-width: 116rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 10rpx;
}

.compact-title {
  font-size: 32rpx;
}

.model-item {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.035);
}

.actions {
  margin-top: 18rpx;
}

.hint {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.channel-picker {
  border-color: #badfd7;
  background: #f3fbf8;
  color: #0f766e;
  font-weight: 700;
}

.inline-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.inline-input {
  flex: 1;
  min-width: 0;
}

.mini-button {
  width: 132rpx;
  min-width: 132rpx;
  padding-left: 0;
  padding-right: 0;
}

.model-picker {
  margin-top: 12rpx;
}

.selected-model {
  min-height: 76rpx;
  border: 1rpx solid #dbe5ee;
  border-radius: 12rpx;
  background: #f8fbfd;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  word-break: break-all;
}

.fetch-button {
  margin-top: 12rpx;
}

.link-button {
  margin-top: 10rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #2563eb;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: left;
}

.link-button::after {
  border: 0;
}

.manual-model-input {
  margin-top: 10rpx;
}

.model-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.model-name {
  min-width: 0;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-word;
}

.model-kind {
  min-width: 72rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #e7f5f2;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}
