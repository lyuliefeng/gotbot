/* Hero */
.settings-hero {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8fffe 0%, #ffffff 100%);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.default-provider-box {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 16rpx;
  background: #ffffff;
}

.default-provider-label {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.default-provider-url {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.35;
  word-break: break-all;
}

/* Quick Actions */
.quick-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quick-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
  transition: all 0.15s;
}

.quick-btn:active {
  border-color: #0f766e;
  background: #f8fffe;
  transform: scale(0.98);
}

.quick-icon {
  font-size: 40rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0fdf9;
  border-radius: 16rpx;
}

.quick-label {
  flex: 1;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.quick-desc {
  color: #94a3b8;
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* Form Panel */
.form-panel {
  margin-bottom: 24rpx;
  border: 1rpx solid #0f766e;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 118, 110, 0.08);
  overflow: hidden;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #f0fdf9;
  border-bottom: 1rpx solid #d1fae5;
}

.form-body {
  padding: 24rpx 28rpx;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #64748b;
  font-size: 32rpx;
  text-align: center;
  line-height: 48rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.form-actions .button-soft {
  flex: 1;
}

.form-actions .button-primary {
  flex: 2;
}

/* Section */
.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 10rpx;
}

.compact-title {
  font-size: 32rpx;
}

/* Empty State */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
  border: 1rpx dashed #d1d5db;
  border-radius: 16rpx;
  background: #fafafa;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  color: #64748b;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  color: #94a3b8;
  font-size: 24rpx;
  margin-top: 8rpx;
  text-align: center;
}

/* Model Cards */
.model-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.model-card {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  transition: all 0.15s;
}

.model-card:active {
  border-color: #0f766e;
  background: #f8fffe;
}

.model-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.model-card-kind {
  min-width: 72rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e7f5f2;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.model-card-latency {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 600;
}

.model-card-name {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-word;
  margin-bottom: 6rpx;
}

.model-card-detail {
  color: #475569;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-all;
  font-family: 'Menlo', 'Courier', monospace;
}

.model-card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
}

.model-card-actions .button-soft,
.model-card-actions .button-danger {
  flex: 1;
  font-size: 26rpx;
  padding: 12rpx 0;
}

/* Shared */
.actions {
  margin-top: 18rpx;
}

.hint {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.channel-picker {
  border-color: #badfd7;
  background: #f3fbf8;
  color: #0f766e;
  font-weight: 700;
}

.model-picker {
  margin-top: 12rpx;
}

.selected-model {
  min-height: 76rpx;
  border: 1rpx solid #dbe5ee;
  border-radius: 12rpx;
  background: #f8fbfd;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  word-break: break-all;
}

.fetch-button {
  margin-top: 12rpx;
}

.link-button {
  margin-top: 10rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #2563eb;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: left;
}

.link-button::after {
  border: 0;
}

.manual-model-input {
  margin-top: 10rpx;
}
