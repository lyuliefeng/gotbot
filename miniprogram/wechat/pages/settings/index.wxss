/* Hero */
.settings-hero {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8fffe 0%, #ffffff 100%);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.default-provider-box {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 16rpx;
  background: #ffffff;
}

.default-provider-label {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.default-provider-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.35;
}

.model-settings-entry {
  margin-top: 24rpx;
}

/* Modal Form */
.settings-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx 24rpx;
  background: rgba(15, 23, 42, 0.48);
  box-sizing: border-box;
}

.settings-modal-panel {
  width: 100%;
  max-height: 88vh;
  border-radius: 28rpx;
  background: #f8fafc;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.22);
  overflow: hidden;
}

.settings-modal-scroll {
  max-height: 72vh;
  padding: 20rpx 20rpx 28rpx;
  box-sizing: border-box;
}

.modal-card {
  margin-bottom: 18rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #f0fdf9;
  border-bottom: 1rpx solid #d1fae5;
}

.form-body {
  padding: 24rpx 28rpx;
}

.third-party-api-card {
  padding: 24rpx 28rpx;
}

.third-party-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #64748b;
  font-size: 32rpx;
  text-align: center;
  line-height: 48rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.form-actions .button-soft {
  flex: 1;
}

.form-actions .button-primary {
  flex: 2;
}

.compact-title {
  font-size: 32rpx;
}

/* Shared */
.actions {
  margin-top: 18rpx;
}

.hint {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.channel-picker {
  border-color: #badfd7;
  background: #f3fbf8;
  color: #0f766e;
  font-weight: 700;
}

.channel-locked {
  border-color: #badfd7;
  background: #f3fbf8;
  color: #0f766e;
  font-weight: 700;
}

.model-picker {
  margin-top: 12rpx;
}

.selected-model {
  min-height: 76rpx;
  border: 1rpx solid #dbe5ee;
  border-radius: 12rpx;
  background: #f8fbfd;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  word-break: break-all;
}

.fetch-button {
  margin-top: 12rpx;
}

.link-button {
  margin-top: 10rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #2563eb;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: left;
}

.link-button::after {
  border: 0;
}

.manual-model-input {
  margin-top: 10rpx;
}
