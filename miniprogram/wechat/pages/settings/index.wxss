.channel-list-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.channel-shell {
  padding-bottom: 18rpx;
}

.channel-list-head .title,
.channel-list-head .subtitle {
  min-width: 0;
}

.editor-section {
  border: 2rpx solid #bfdbfe;
}

.empty-state {
  margin-top: 24rpx;
  border: 1rpx dashed #cbd5e1;
  border-radius: 12rpx;
  padding: 28rpx;
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
}

.channel-row {
  border-top: 1rpx solid #e2e8f0;
  padding: 18rpx 0;
}

.channel-row.disabled {
  opacity: 0.68;
}

.channel-head,
.switch-row,
.discovery-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.channel-name,
.discovery-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-main {
  min-width: 0;
  flex: 1;
}

.channel-url {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-badges,
.row-actions,
.toolbar-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.channel-badges {
  justify-content: flex-end;
  flex-shrink: 0;
}

.channel-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 8rpx;
}

.status-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 22rpx;
}

.kind-pill {
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #e0f2fe;
  color: #075985;
  font-size: 22rpx;
}

.channel-row.disabled .status-pill {
  background: #f1f5f9;
  color: #64748b;
}

.switch-row {
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
  border-bottom: 1rpx solid #e2e8f0;
}

.inline-label {
  margin-bottom: 2rpx;
}

.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  word-break: break-all;
}

.actions {
  margin-top: 18rpx;
}

.row-actions {
  margin-top: 12rpx;
}

.toolbar-actions {
  margin-top: 16rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.form-grid .field {
  margin-top: 0;
}

.key-area {
  height: 112rpx;
}

.note-area {
  height: 104rpx;
}

.compact {
  flex-shrink: 0;
  min-width: 148rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
}

.inline-actions {
  margin-top: 0;
  flex-shrink: 0;
}

.discovery-list {
  margin-top: 18rpx;
  border-top: 1rpx solid #e2e8f0;
}

.subhead {
  padding-top: 20rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.discovery-item {
  align-items: stretch;
  flex-direction: column;
  padding: 14rpx 0;
  border-top: 1rpx solid #eef2f7;
}

.discovery-meta {
  min-width: 0;
  width: 100%;
  flex: 1;
}

.discovery-name {
  white-space: normal;
  word-break: break-all;
}

.discovery-item .muted {
  word-break: break-all;
}

.discovery-item .inline-actions {
  width: 100%;
  justify-content: flex-start;
}

.discovery-item .button-soft {
  min-width: 180rpx;
}

.latency-row {
  margin-top: 0;
  font-size: 24rpx;
  color: #64748b;
  flex-shrink: 0;
}

.model-scroll {
  max-height: 520rpx;
}

.latency-green {
  color: #16a34a;
}

.latency-yellow {
  color: #ca8a04;
}

.latency-red {
  color: #dc2626;
}
