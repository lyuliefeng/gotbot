<view class="page">
  <view class="settings-hero">
    <view class="eyebrow">Model Hub</view>
    <view class="title">模型配置</view>
    <view class="subtitle">请添加自己的第三方 API，上游地址、模型 ID 和 Key 都不会预填。</view>
    <button class="button-primary model-settings-entry" bindtap="openModelSettings">打开模型设置</button>
  </view>

  <!-- 模型设置弹窗 -->
  <view wx:if="{{formOpen}}" class="settings-modal-mask" catchtap="closeForm">
    <view class="settings-modal-panel" catchtap="noop">
      <view class="form-header settings-modal-header">
        <view>
          <view class="eyebrow">Model Settings</view>
          <view class="title compact-title">{{formTitle}}</view>
        </view>
        <view class="close-btn" bindtap="closeForm">×</view>
      </view>

      <scroll-view scroll-y class="settings-modal-scroll">
        <view class="third-party-api-card modal-card">
          <view class="third-party-header">
            <view>
              <view class="default-provider-label">第三方 API</view>
              <view class="default-provider-desc">用一个模型类型开关切换大语言模型、生图模型和视频模型，再填写对应接口。</view>
            </view>
          </view>

          <view class="field">
            <view class="label">模型类型开关</view>
            <picker mode="selector" range="{{kindLabels}}" value="{{kindIndex}}" bindchange="onKindChange">
              <view class="picker-box channel-picker">{{currentKindLabel}}</view>
            </picker>
            <view class="hint">{{kindHint}}</view>
          </view>

          <view class="field">
            <view class="label">{{endpointLabel}}</view>
            <input class="input" value="{{draft.endpoint}}" data-field="endpoint" bindinput="onInput" placeholder="https://api.example.com" />
          </view>

          <view class="field">
            <view class="label">API Key</view>
            <input class="input" password value="{{draft.apiKey}}" data-field="apiKey" bindinput="onInput" placeholder="sk-..." />
          </view>

          <view class="field">
            <view class="label">模型 ID</view>
            <view class="selected-model">{{currentModelText}}</view>
            <button class="button-soft fetch-button" loading="{{isFetchingModels}}" bindtap="fetchModels">扫描第三方 API</button>
            <picker wx:if="{{modelOptions.length}}" mode="selector" range="{{modelOptions}}" range-key="name" value="{{modelIndex}}" bindchange="onModelChange">
              <view class="picker-box model-picker">{{currentModelLabel}}</view>
            </picker>
            <button class="link-button" bindtap="toggleManualModelInput">没有拉取到？手动填写模型 ID</button>
            <input wx:if="{{showManualModelInput}}" class="input manual-model-input" value="{{draft.model}}" data-field="model" bindinput="onInput" placeholder="填写第三方接口返回的模型 ID" />
          </view>

          <view class="form-actions">
            <button class="button-soft" bindtap="testModel">检测连接</button>
            <button class="button-primary" bindtap="save">保存第三方模型</button>
          </view>
          <view wx:if="{{notice}}" class="success-text">{{notice}}</view>
          <view wx:if="{{error}}" class="danger-text">{{error}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
