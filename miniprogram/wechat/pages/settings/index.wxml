<view class="page">
  <view class="settings-hero">
    <view class="eyebrow">Model Hub</view>
    <view class="title">模型配置</view>
    <view class="subtitle">配置图片或视频通道。创作工作台会按通道自动匹配模型。</view>
  </view>

  <view class="section config-section">

    <view class="field">
      <view class="label">名称</view>
      <picker mode="selector" range="{{nameOptions}}" value="{{nameIndex}}" bindchange="onNameModeChange">
        <view class="picker-box">{{currentNameLabel}}</view>
      </picker>
    </view>
    <view wx:if="{{showCustomName}}" class="field">
      <view class="label">自定义名称</view>
      <input class="input" value="{{draft.name}}" data-field="name" bindinput="onInput" placeholder="例如：公司图像模型" />
    </view>

    <view class="field">
      <view class="label">模型类型</view>
      <picker mode="selector" range="{{kindLabels}}" value="{{kindIndex}}" bindchange="onKindChange">
        <view class="picker-box channel-picker">{{currentKindLabel}}</view>
      </picker>
      <view class="hint">{{kindHint}}</view>
    </view>

    <view class="field">
      <view class="label">Key 来源</view>
      <picker mode="selector" range="{{keyModeLabels}}" value="{{keyModeIndex}}" bindchange="onKeyModeChange">
        <view class="picker-box">{{currentKeyModeLabel}}</view>
      </picker>
      <view class="hint">{{keyModeHint}}</view>
    </view>

    <view class="field">
      <view class="label">接口地址</view>
      <input class="input" value="{{draft.endpoint}}" data-field="endpoint" bindinput="onInput" placeholder="https://api.example.com" />
      <view class="hint">示例：https://apihub.agnes-ai.com。接口路径已固定，不需要填写 API Path。</view>
    </view>

    <view wx:if="{{showUserKeyFields}}" class="field">
      <view class="label">API Key</view>
      <input class="input" password value="{{draft.apiKey}}" data-field="apiKey" bindinput="onInput" placeholder="sk-..." />
    </view>

    <view class="field">
      <view class="label">模型 ID</view>
      <view class="selected-model">{{currentModelText}}</view>
      <button class="button-soft fetch-button" loading="{{isFetchingModels}}" bindtap="fetchModels">拉取模型列表</button>
      <picker wx:if="{{modelOptions.length}}" mode="selector" range="{{modelOptions}}" range-key="name" value="{{modelIndex}}" bindchange="onModelChange">
        <view class="picker-box model-picker">{{currentModelLabel}}</view>
      </picker>
      <button class="link-button" bindtap="toggleManualModelInput">没有拉取到？手动填写模型 ID</button>
      <input wx:if="{{showManualModelInput}}" class="input manual-model-input" value="{{draft.model}}" data-field="model" bindinput="onInput" placeholder="例如：agnes-image-2.1-flash" />
    </view>

    <view class="actions">
      <button class="button-primary" bindtap="save">保存模型</button>
      <button class="button-soft" bindtap="testModel">检测连接</button>
    </view>
    <view wx:if="{{notice}}" class="success-text">{{notice}}</view>
    <view wx:if="{{error}}" class="danger-text">{{error}}</view>
  </view>

  <view class="section">
    <view class="section-heading">
      <view>
        <view class="title compact-title">已配置模型</view>
        <view class="subtitle">图片和视频模型会在创作时自动分流。</view>
      </view>
    </view>
    <view wx:for="{{models}}" wx:key="id" class="model-item">
      <view class="model-row-head">
        <view class="model-name">{{item.name}}</view>
        <view class="model-kind">{{item.kindLabel}}</view>
      </view>
      <view class="muted">{{item.summary}}</view>
      <view class="actions">
        <button class="button-soft" data-id="{{item.id}}" bindtap="edit">编辑</button>
        <button class="button-danger" data-id="{{item.id}}" bindtap="remove">删除</button>
      </view>
    </view>
  </view>
</view>
