.scan-page {
  min-height: 100vh;
  background: #020617;
  overflow: hidden;
  position: relative;
}

.camera {
  width: 100vw;
  height: 100vh;
}

.top-panel,
.answer-panel {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  z-index: 2;
}

.top-panel {
  top: 28rpx;
}

.selector-row,
.status-row,
.mode-row,
.action-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.selector {
  flex: 1;
  min-width: 160rpx;
}

.selector-value,
.status-pill,
.mode-chip,
.action-button {
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  font-size: 24rpx;
  line-height: 1.2;
  padding: 16rpx 18rpx;
  text-align: center;
}

.status-row {
  margin-top: 12rpx;
}

.status-pill {
  font-size: 22rpx;
}

.answer-panel {
  bottom: 26rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(248, 250, 252, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.mode-chip {
  color: #0f172a;
  background: #e2e8f0;
  border-color: #cbd5e1;
}

.mode-chip.active {
  background: #2563eb;
  color: #fff;
}

.mode-chip::after,
.action-button::after {
  border: 0;
}

.detected-card,
.answer-card {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.panel-label {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.detected-text,
.answer-text {
  font-size: 27rpx;
  color: #0f172a;
  line-height: 1.55;
}

.citation-text {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #0f766e;
  line-height: 1.45;
}

.question-input {
  width: 100%;
  min-height: 92rpx;
  margin-top: 14rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  font-size: 26rpx;
  color: #0f172a;
}

.action-row {
  margin-top: 14rpx;
}

.action-button {
  flex: 1;
  min-width: 150rpx;
  color: #0f172a;
  background: #fff;
  border-color: #cbd5e1;
}

.action-button.primary {
  color: #fff;
  background: #2563eb;
  border-color: #2563eb;
}

.error-text {
  margin-top: 12rpx;
  color: #b91c1c;
  font-size: 24rpx;
}
