.learning-hero {
  padding: 36rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #0f766e, #2563eb);
  color: #fff;
  margin-bottom: 24rpx;
}

.eyebrow {
  font-size: 23rpx;
  opacity: 0.78;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.12;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.55;
  opacity: 0.9;
}

.hero-actions,
.stats-row,
.task-list {
  display: flex;
  gap: 14rpx;
}

.hero-actions {
  margin-top: 28rpx;
}

.hero-button {
  flex: 1;
}

.stats-row {
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  padding: 22rpx 14rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  text-align: center;
}

.stat-value {
  font-size: 31rpx;
  font-weight: 800;
  color: #0f172a;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.task-list {
  flex-direction: column;
  margin-top: 18rpx;
}

.task-card {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f8fbfd;
  border: 1rpx solid #e2e8f0;
}

.task-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #0f172a;
}

.task-action {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 700;
}

.compact-title {
  font-size: 32rpx;
}
