<view class="page">
  <view class="section">
    <view class="title">教材库</view>
    <view class="subtitle">第一版教材由后台导入和审核，小程序端负责选择教材、学习和答疑。</view>
    <view class="selector-row">
      <picker class="selector" mode="selector" range="{{stages}}" value="{{stageIndex}}" bindchange="onStageChange">
        <view class="picker-box">{{selectedStage}}</view>
      </picker>
      <picker class="selector" mode="selector" range="{{subjects}}" value="{{subjectIndex}}" bindchange="onSubjectChange">
        <view class="picker-box">{{selectedSubject}}</view>
      </picker>
    </view>
  </view>

  <view class="section">
    <view class="title compact-title">推荐教材</view>
    <view wx:for="{{textbooks}}" wx:key="id" class="book-card">
      <view class="book-cover">{{item.version}}</view>
      <view class="book-body">
        <view class="book-title">{{item.title}}</view>
        <view class="muted">{{item.chapters}} 个章节 · {{item.status}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="title compact-title">章节示例</view>
    <view wx:for="{{chapters}}" wx:key="id" class="chapter-card">
      <view class="chapter-title">{{item.title}}</view>
      <view class="muted">{{item.desc}}</view>
      <button class="button-soft chapter-button" bindtap="openScan">围绕本章视频答题</button>
    </view>
  </view>
</view>
