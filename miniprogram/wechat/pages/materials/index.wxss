.selector-row {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.selector {
  flex: 1;
}

.compact-title {
  font-size: 32rpx;
}

.book-card,
.chapter-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #f8fbfd;
}

.book-card {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.book-cover {
  width: 108rpx;
  height: 136rpx;
  border-radius: 14rpx;
  background: #dbeafe;
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.book-body {
  flex: 1;
}

.book-title,
.chapter-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.chapter-button {
  margin-top: 16rpx;
}
