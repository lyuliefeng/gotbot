<view class="page">
  <view class="workspace-hero">
    <view class="eyebrow">Create Studio</view>
    <view class="title">创作工作台</view>
    <view class="subtitle">选择通道后进入配置面板，模型会按图片或视频自动匹配。</view>
  </view>

  <view class="section tool-section">
    <view class="section-heading">
      <view>
        <view class="title compact-title">创作类型</view>
        <view class="subtitle">常用生图、生视频入口</view>
      </view>
    </view>
    <view class="tool-grid">
      <button wx:for="{{toolTabs}}" wx:key="id" class="tool-card {{item.activeClass}}" data-id="{{item.id}}" bindtap="selectTool">
        <view class="tool-badge">{{item.modeLabel}}</view>
        <view class="tool-title">{{item.title}}</view>
        <view class="tool-desc">{{item.desc}}</view>
      </button>
    </view>
  </view>

  <view wx:if="{{currentTask}}" class="section">
    <view class="title">本次结果</view>
    <view wx:if="{{isVideoResult}}" class="muted">当前视频模式先生成视频首帧/分镜预览；MP4 生成将在接入视频模型后开放。</view>
    <view class="grid">
      <view wx:for="{{currentAssets}}" wx:key="id" class="card">
        <image class="preview" src="{{item.assetUrl}}" mode="aspectFill" data-url="{{item.assetUrl}}" bindtap="previewAsset" />
        <view>{{item.title}}</view>
        <view class="muted">{{item.width}} x {{item.height}}</view>
        <button class="button-soft" data-url="{{item.remoteUrl}}" bindtap="saveAsset">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{composerOpen}}" class="composer-mask" catchtap="closeComposer">
    <view class="composer-panel" catchtap="noop">
      <image wx:if="{{referenceBackdropVisible}}" class="reference-backdrop" src="{{referenceImage}}" mode="aspectFill" />
      <view class="composer-header">
        <view>
          <view class="title">{{composerTitle}}</view>
          <view class="subtitle">{{composerSubtitle}}</view>
        </view>
        <button class="close-button" bindtap="closeComposer">×</button>
      </view>

      <view class="composer-meta">
        <view class="meta-item">
          <view class="meta-label">模型</view>
          <view class="meta-value">{{selectedModelName}}</view>
        </view>
        <view class="meta-item">
          <view class="meta-label">尺寸</view>
          <view class="meta-value">{{width}} x {{height}}</view>
        </view>
      </view>

      <view class="field">
        <view class="label">模型</view>
        <picker mode="selector" range="{{models}}" range-key="name" value="{{modelIndex}}" bindchange="onModelChange">
          <view class="picker-box">{{selectedModelName}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="label">分辨率</view>
        <picker mode="selector" range="{{resolutionOptions}}" value="{{resolutionIndex}}" bindchange="onResolutionChange">
          <view class="picker-box">{{width}} x {{height}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="label">提示词</view>
        <textarea class="textarea" value="{{prompt}}" data-field="prompt" bindinput="onInput" placeholder="描述主体、风格、光线和场景" />
        <button class="polish-wide-button" loading="{{polishingPrompt}}" disabled="{{polishingPrompt}}" bindtap="polishPrompt">{{polishPromptText}}</button>
      </view>

      <view class="chips">
        <button wx:for="{{prompts}}" wx:key="id" class="button-soft" data-id="{{item.id}}" bindtap="selectPrompt">{{item.title}}</button>
      </view>

      <view class="field">
        <view class="label">反向提示词</view>
        <textarea class="textarea small-textarea" value="{{negativePrompt}}" data-field="negativePrompt" bindinput="onInput" placeholder="不希望出现的内容" />
        <button class="polish-wide-button" loading="{{polishingNegativePrompt}}" disabled="{{polishingNegativePrompt}}" bindtap="polishNegativePrompt">{{polishNegativePromptText}}</button>
      </view>

      <view wx:if="{{activeTool.referenceRequired}}" class="field">
        <view class="label">参考图</view>
        <view class="reference-picker">
          <button class="button-soft reference-button" bindtap="chooseReference">选择参考图</button>
          <image wx:if="{{referenceImage}}" class="reference-preview" src="{{referenceImage}}" mode="aspectFill" />
        </view>
      </view>

      <button class="button-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="generate">{{generateButtonText}}</button>
      <view wx:if="{{error}}" class="danger-text">{{error}}</view>
      <view wx:if="{{notice}}" class="success-text">{{notice}}</view>
    </view>
  </view>
</view>
