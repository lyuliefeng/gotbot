<view class="page">
  <view class="section">
    <view class="title">创作工作台</view>
    <view class="subtitle">选择工具、模型与参数，生成结果会进入云端资产库。</view>
    <view class="chips">
      <button wx:for="{{toolTabs}}" wx:key="id" class="chip {{item.activeClass}}" data-id="{{item.id}}" bindtap="selectTool">{{item.title}}</button>
    </view>
  </view>

  <view class="section">
    <view class="label">提示词</view>
    <textarea class="textarea" value="{{prompt}}" data-field="prompt" bindinput="onInput" placeholder="描述主体、风格、光线和场景" />
    <view class="chips">
      <button wx:for="{{prompts}}" wx:key="id" class="button-soft" data-id="{{item.id}}" bindtap="selectPrompt">{{item.title}}</button>
    </view>
  </view>

  <view class="section">
    <view class="field">
      <view class="label">模型</view>
      <picker mode="selector" range="{{models}}" range-key="name" value="{{modelIndex}}" bindchange="onModelChange">
        <view class="picker-box">{{selectedModelName}}</view>
      </picker>
    </view>
    <view class="row">
      <view class="field half"><view class="label">宽度</view><input class="input" type="number" value="{{width}}" data-field="width" bindinput="onInput" /></view>
      <view class="field half"><view class="label">高度</view><input class="input" type="number" value="{{height}}" data-field="height" bindinput="onInput" /></view>
      <view class="field half"><view class="label">数量</view><input class="input" type="number" value="{{batchSize}}" data-field="batchSize" bindinput="onInput" /></view>
      <view class="field half"><view class="label">步数</view><input class="input" type="number" value="{{steps}}" data-field="steps" bindinput="onInput" /></view>
    </view>
    <view wx:if="{{activeTool.referenceRequired}}" class="field">
      <view class="label">参考图</view>
      <button class="button-soft" bindtap="chooseReference">选择参考图</button>
      <view class="muted">{{referenceImage}}</view>
    </view>
    <button class="button-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="generate">{{generateButtonText}}</button>
    <view wx:if="{{error}}" class="danger-text">{{error}}</view>
    <view wx:if="{{notice}}" class="success-text">{{notice}}</view>
  </view>

  <view wx:if="{{currentTask}}" class="section">
    <view class="title">本次结果</view>
    <view class="grid">
      <view wx:for="{{currentAssets}}" wx:key="id" class="card">
        <image class="preview" src="{{item.assetUrl}}" mode="aspectFill" data-url="{{item.assetUrl}}" bindtap="previewAsset" />
        <view>{{item.title}}</view>
        <view class="muted">{{item.width}} x {{item.height}}</view>
        <button class="button-soft" data-url="{{item.remoteUrl}}" bindtap="saveAsset">保存</button>
      </view>
    </view>
  </view>
</view>
