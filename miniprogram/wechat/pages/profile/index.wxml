<view class="page">
  <view class="profile-card">
    <view class="avatar">问</view>
    <view>
      <view class="profile-name">{{profile.name}}</view>
      <view class="profile-level">{{profile.level}}</view>
      <view class="profile-summary">{{profile.summary}}</view>
    </view>
  </view>

  <view class="section">
    <view class="title compact-title">学习记录</view>
    <view wx:for="{{records}}" wx:key="id" class="record-row">
      <view>{{item.label}}</view>
      <view class="record-value">{{item.value}}</view>
    </view>
  </view>

  <view class="section">
    <view class="title compact-title">隐私设置</view>
    <view wx:for="{{privacy}}" wx:key="*this" class="privacy-item">{{item}}</view>
  </view>
</view>
