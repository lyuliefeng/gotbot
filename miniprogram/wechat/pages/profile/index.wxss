.profile-card {
  display: flex;
  gap: 22rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  margin-bottom: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #0f766e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 900;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #0f172a;
}

.profile-level,
.profile-summary {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.5;
}

.compact-title {
  font-size: 32rpx;
}

.record-row,
.privacy-item {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f8fbfd;
  border: 1rpx solid #e2e8f0;
  font-size: 27rpx;
}

.record-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.record-value {
  color: #2563eb;
  font-weight: 800;
}
