.tools-hero {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.045);
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.empty-tool-panel {
  padding: 42rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.045);
  text-align: center;
}

.empty-mark {
  display: inline-flex;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #e7f5f2;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.empty-title {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-text {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}

.button-primary {
  width: 100%;
  margin-top: 28rpx;
}

.placeholder-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.placeholder-item {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #cbd5e1;
  border-radius: 14rpx;
  background: #f8fbfd;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 700;
}
