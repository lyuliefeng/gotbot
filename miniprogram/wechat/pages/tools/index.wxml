<view class="page">
  <view class="tools-hero">
    <view class="eyebrow">Toolbox</view>
    <view class="title">工具库</view>
    <view class="subtitle">首版聚焦图像主链路，视频能力二期补齐。</view>
  </view>

  <view class="tool-list">
    <view wx:for="{{tools}}" wx:key="id" class="tool-item">
      <view class="tool-head">
        <view class="tool-name">{{item.title}}</view>
        <view class="tool-mode">{{item.modeLabel}}</view>
      </view>
      <view class="muted">{{item.desc}}</view>
      <button class="button-soft" bindtap="goWorkspace">去创作</button>
    </view>
  </view>
</view>
