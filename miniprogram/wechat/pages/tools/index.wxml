<view class="page">
  <view class="section">
    <view class="title">工具库</view>
    <view class="subtitle">首版聚焦图像主链路，视频能力二期补齐。</view>
  </view>
  <view class="grid">
    <view wx:for="{{tools}}" wx:key="id" class="card">
      <view class="title small">{{item.title}}</view>
      <view class="muted">{{item.desc}}</view>
      <view class="muted">{{item.modeLabel}}</view>
      <button class="button-soft" bindtap="goWorkspace">去创作</button>
    </view>
  </view>
</view>
